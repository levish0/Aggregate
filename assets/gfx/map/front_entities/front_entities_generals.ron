                Property(key: "has_culture_graphics", operator: Assign, value: Symbol("european")),
            ])),
            Property(key: "scope:country", operator: Assign, value: Block([
                Property(key: "OR", operator: Assign, value: Block([
                    Property(key: "NOT", operator: Assign, value: Block([
                        Property(key: "c:SPC", operator: Exists, value: Symbol("this")),
                    ])),
                    Property(key: "AND", operator: Assign, value: Block([
                        Property(key: "c:SPC", operator: Exists, value: Symbol("this")),
                        Property(key: "NOT", operator: Assign, value: Block([Property(key: "has_dlc_feature", operator: Assign, value: Symbol("ip4_cosmetics"))])),
                    ])),
                ])),
            ])),
        ])),
    ])),
