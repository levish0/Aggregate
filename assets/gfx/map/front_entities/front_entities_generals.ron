(schema_version: 1, entries: [
    Property(key: "military_infantry_carlist_general_diorama_entity", operator: Assign, value: Block([
        Property(key: "entity", operator: Assign, value: Text("military_infantry_carlists_general_entity")),
        Property(key: "group", operator: Assign, value: Text("general")),
        Property(key: "trigger", operator: Assign, value: Block([
            Property(key: "scope:country", operator: Assign, value: Block([
                Property(key: "c:SPC", operator: Exists, value: Symbol("this")),
